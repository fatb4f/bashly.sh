# :command.normalize_input
# :command.normalize_input_function
normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}


# :command.inspect_args
inspect_args() {
  local k

  if ((${#args[@]})); then
    readarray -t sorted_keys < <(printf '%s\n' "${!args[@]}" | sort)
    echo args:
    for k in "${sorted_keys[@]}"; do
      echo "- \${args[$k]} = ${args[$k]}"
    done
  else
    echo args: none
  fi

  if ((${#deps[@]})); then
    readarray -t sorted_keys < <(printf '%s\n' "${!deps[@]}" | sort)
    echo
    echo deps:
    for k in "${sorted_keys[@]}"; do
      echo "- \${deps[$k]} = ${deps[$k]}"
    done
  fi

  if ((${#env_var_names[@]})); then
    readarray -t sorted_names < <(printf '%s\n' "${env_var_names[@]}" | sort)
    echo
    echo "environment variables:"
    for k in "${sorted_names[@]}"; do
      echo "- \$$k = ${!k:-}"
    done
  fi
}

# :command.user_lib
# src/lib/session.sh
session_hyprlock_config() {
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprlock.conf"
}

session_lock_request() {
  local sid="${XDG_SESSION_ID:-}"

  if [[ -n "$sid" ]]; then
    loginctl lock-session "$sid"
  else
    loginctl lock-session
  fi
}

session_unlock_now() {
  if [[ -n "${XDG_SESSION_ID:-}" ]]; then
    loginctl unlock-session "$XDG_SESSION_ID" || true
  else
    loginctl unlock-sessions || true
  fi
}

session_locker() {
  local hyprlock_config user_name

  user_name="${USER:-$(id -un)}"

  if pgrep -xu "$user_name" hyprlock > /dev/null 2>&1; then
    return 0
  fi

  systemctl --user start locked-session-halt.timer || true

  hyprlock_config="$(session_hyprlock_config)"

  if [[ -f "$hyprlock_config" ]]; then
    exec hyprlock \
      --config "$hyprlock_config" \
      --immediate-render \
      --no-fade-in
  else
    exec hyprlock \
      --immediate-render \
      --no-fade-in
  fi
}

session_unlock() {
  systemctl --user stop locked-session-halt.timer || true
  session_unlock_now
}




