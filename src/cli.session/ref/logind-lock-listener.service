# Owner: user-session
# Class: session-companion
# Start: wayland-session@niri.desktop.target.wants
# Enablement: enabled for wayland-session@niri.desktop.target

[Unit]
Description=Bridge logind Lock/Unlock signals to locker and halt timer
Documentation=man:loginctl(1) man:org.freedesktop.login1(5)
PartOf=wayland-wm@hyprland.desktop.service
After=wayland-wm@hyprland.desktop.service
Requisite=wayland-wm@hyprland.desktop.service

[Service]
Type=simple
ExecStart=%h/.local/bin/logind-lock-listener
Restart=on-failure
RestartSec=2

[Install]
WantedBy=wayland-wm@hyprland.desktop.service
