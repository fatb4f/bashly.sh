#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
break_until="$runtime_dir/pomodoro/break-until"

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send "Pomodoro" "$1"
}

remaining_break_seconds() {
  [[ -f "$break_until" ]] || {
    printf '0\n'
    return 0
  }

  now="$(date +%s)"
  until_ts="$(cat "$break_until" 2>/dev/null || printf '0')"

  if ((until_ts > now)); then
    printf '%s\n' "$((until_ts - now))"
  else
    printf '0\n'
  fi
}

unlock_now() {
  if [[ -n "${XDG_SESSION_ID:-}" ]]; then
    loginctl unlock-session "$XDG_SESSION_ID" || true
  else
    loginctl unlock-sessions || true
  fi
}

remaining="$(remaining_break_seconds)"

if ((remaining > 0)); then
  minutes="$(((remaining + 59) / 60))"
  notify "Nice try. Break has about ${minutes}m left."

  # Fallback only. PAM should normally prevent reaching this path.
  systemd-run --user \
    --unit=session-relock \
    --collect \
    --on-active=250ms \
    systemctl --user start session-lock.service || true

  exit 75
fi

rm -f "$break_until"
systemctl --user stop locked-session-halt.timer || true
unlock_now
