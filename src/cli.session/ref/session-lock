#!/usr/bin/env bash
set -euo pipefail

session_bin="${SESSION_BIN:-session}"

if ! command -v "$session_bin" >/dev/null 2>&1; then
  fallback="$HOME/.local/bin/session"
  if [[ -x "$fallback" ]]; then
    session_bin="$fallback"
  fi
fi

case "${1:-}" in
  "" | --request)
    exec "$session_bin" lock
    ;;

  --run-locker)
    exec "$session_bin" locker
    ;;

  *)
    printf 'usage: session-lock [--request|--run-locker]\n' >&2
    exit 64
    ;;
esac
