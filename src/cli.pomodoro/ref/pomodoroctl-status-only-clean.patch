+# pomodoroctl: status-only Bashly implementation.
+#
+# Contract:
+#   - Bashly owns dispatch/help for the single public command: status.
+#   - This library reads the old executable's state file contract.
+#   - This library does not mutate Pomodoro state or arm timers.
+
+pomodoro_init_defaults() {
+  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pomodoroctl"
+  STATE_FILE="$STATE_DIR/state.env"
+
+  WORK_TIMER="pomodoro-work.timer"
+  SHORT_BREAK_TIMER="pomodoro-short-break.timer"
+  LONG_BREAK_TIMER="pomodoro-long-break.timer"
+  CYCLE_SERVICE="pomodoro-cycle.service"
+}
+
+pomodoro_now_epoch() {
+  date +%s
+}
+
+pomodoro_iso_local_from_epoch() {
+  local epoch="$1"
+
+  if [[ -z "$epoch" || "$epoch" == "0" ]]; then
+    printf '\n'
+    return 0
+  fi
+
+  date --date="@$epoch" '+%Y-%m-%d %H:%M:%S %Z'
+}
+
+pomodoro_load_state() {
+  PHASE=idle
+  CYCLE=0
+  BREAK_KIND=
+  WORK_STARTED_AT=0
+  WORK_UNTIL=0
+  BREAK_STARTED_AT=0
+  BREAK_UNTIL=0
+  LAST_TRANSITION_AT=0
+
+  if [[ -f "$STATE_FILE" ]]; then
+    # shellcheck disable=SC1090
+    source "$STATE_FILE"
+  fi
+
+  PHASE="${PHASE:-idle}"
+  CYCLE="${CYCLE:-0}"
+  BREAK_KIND="${BREAK_KIND:-}"
+  WORK_STARTED_AT="${WORK_STARTED_AT:-0}"
+  WORK_UNTIL="${WORK_UNTIL:-0}"
+  BREAK_STARTED_AT="${BREAK_STARTED_AT:-0}"
+  BREAK_UNTIL="${BREAK_UNTIL:-0}"
+  LAST_TRANSITION_AT="${LAST_TRANSITION_AT:-0}"
+}
+
+pomodoro_remaining_seconds() {
+  local until="$1"
+  local now remaining
+
+  now="$(pomodoro_now_epoch)"
+  remaining=$((until - now))
+
+  if (( remaining < 0 )); then
+    remaining=0
+  fi
+
+  printf '%s\n' "$remaining"
+}
+
+pomodoro_status() {
+  pomodoro_load_state
+
+  local break_remaining work_remaining
+  break_remaining=0
+  work_remaining=0
+
+  if [[ "$PHASE" == "break" && "$BREAK_UNTIL" =~ ^[0-9]+$ ]]; then
+    break_remaining="$(pomodoro_remaining_seconds "$BREAK_UNTIL")"
+  fi
+
+  if [[ "$PHASE" == "work" && "$WORK_UNTIL" =~ ^[0-9]+$ ]]; then
+    work_remaining="$(pomodoro_remaining_seconds "$WORK_UNTIL")"
+  fi
+
+  printf 'cycle=%s\n' "$CYCLE"
+  printf 'phase=%s\n' "$PHASE"
+  printf 'break_kind=%s\n' "$BREAK_KIND"
+  printf 'break_until=%s\n' "$(pomodoro_iso_local_from_epoch "$BREAK_UNTIL")"
+  printf 'break_remaining_seconds=%s\n' "$break_remaining"
+  printf 'work_until=%s\n' "$(pomodoro_iso_local_from_epoch "$WORK_UNTIL")"
+  printf 'work_remaining_seconds=%s\n' "$work_remaining"
+  printf 'last_transition_at=%s\n' "$(pomodoro_iso_local_from_epoch "$LAST_TRANSITION_AT")"
+  printf '\n'
+
+  if [[ "${POMODOROCTL_NO_SYSTEMD:-0}" == "1" ]]; then
+    return 0
+  fi
+
+  systemctl --user --no-pager --plain list-units \
+    "$CYCLE_SERVICE" \
+    "pomodoro-work.service" \
+    "pomodoro-break.service" \
+    "$WORK_TIMER" \
+    "$SHORT_BREAK_TIMER" \
+    "$LONG_BREAK_TIMER" || true
+
+  printf '\n'
+
+  systemctl --user --no-pager --plain list-timers \
+    "$WORK_TIMER" \
+    "$SHORT_BREAK_TIMER" \
+    "$LONG_BREAK_TIMER" || true
+}
