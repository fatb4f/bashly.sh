# :command.usage
cli.notify_usage() {
  printf "cli.notify - Bashly-authored dispatcher for Hyprland backlight and sound notifications\n\n"

  printf "%s\n" "Usage:"
  printf "  cli.notify COMMAND\n"
  printf "  cli.notify [COMMAND] --help | -h\n"
  printf "  cli.notify --version | -v\n"
  echo
  # :command.usage_commands
  printf "%s\n" "Commands:"
  printf "  %s   Backlight notification namespace\n" "backlight"
  printf "  %s   Sound notification namespace\n" "sound    "
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "Options:"

    # :command.usage_fixed_flags
    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "--version, -v"
    printf "    Show version number\n"
    echo

  fi
}

