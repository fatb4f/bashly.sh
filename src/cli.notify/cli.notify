# :command.initialize
initialize() {
  declare -g version="0.1.0"
  set -e

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "backlight") cli.notify_backlight_command ;;
    "backlight up") cli.notify_backlight_up_command ;;
    "backlight down") cli.notify_backlight_down_command ;;
    "sound") cli.notify_sound_command ;;
    "sound up") cli.notify_sound_up_command ;;
    "sound down") cli.notify_sound_down_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # :command.start
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
fi
