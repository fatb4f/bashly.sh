#!/usr/bin/env sh
# managed Codex repo search adapter
# shellcheck shell=sh
set -eu

usage() {
  cat >&2 <<'EOF'
usage:
  repo-rg KEYWORD [ROOT]

examples:
  repo-rg CODEX_HOME
  repo-rg codex_profile init/src
  repo-rg "session-init.sh" /path/to/repo

env:
  REPO_RG_MAX_RESULTS=200
  REPO_RG_MODE=literal|regex
  RG_BIN=$HOME/.local/bin/rg
EOF
}

[ "${1-}" ] || {
  usage
  exit 64
}

keyword=$1
root=${2:-.}
mode=${REPO_RG_MODE:-literal}
max_results=${REPO_RG_MAX_RESULTS:-200}
rg_bin=${RG_BIN:-"/usr/sbin/rg"}

case "$max_results" in
'' | *[!0-9]*)
  printf >&2 'error: REPO_RG_MAX_RESULTS must be a positive integer: %s
' "$max_results"
  exit 64
  ;;
esac
[ "$max_results" -gt 0 ] || {
  printf >&2 'error: REPO_RG_MAX_RESULTS must be greater than zero
'
  exit 64
}

if [ ! -x "$rg_bin" ]; then
  if command -v rg >/dev/null 2>&1; then
    rg_bin=$(command -v rg)
  else
    printf >&2 'error: rg not found at %s and not available on PATH
' "$rg_bin"
    exit 127
  fi
fi

if git_root=$(git -C "$root" rev-parse --show-toplevel 2>/dev/null); then
  root=$git_root
else
  root=$(cd "$root" && pwd -P)
fi

case "$root" in
"$HOME")
  printf >&2 'error: refusing to search $HOME directly; pass a repo or subdir root
'
  exit 64
  ;;
esac

case "$mode" in
literal)
  set -- --fixed-strings
  ;;
regex)
  set --
  ;;
*)
  printf >&2 'error: invalid REPO_RG_MODE: %s
' "$mode"
  exit 64
  ;;
esac

"$rg_bin" "$@" --line-number --column --hidden --color=never --glob '!.git/**' --glob '!node_modules/**' --glob '!__pycache__/**' --glob '!.mypy_cache/**' --glob '!.pytest_cache/**' --glob '!target/**' --glob '!dist/**' --glob '!build/**' -- "$keyword" "$root" | sed -n "1,${max_results}p"
