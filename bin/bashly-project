#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

run_graph_only() {
  PYTHONPATH="$repo_root/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 - "$@" <<'PY'
from __future__ import annotations

import sys

from bashly_bridge.bashly_graph import GraphError, build_graph_projection_json
from bashly_bridge.discovery import DiscoveryError


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    workspace = args[0] if args else "."
    try:
        print(build_graph_projection_json(workspace))
    except (DiscoveryError, GraphError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    return 0


raise SystemExit(main())
PY
}

run_source_only() {
  workspace=${1:-.}
  exec nvim --headless -n -u NONE \
    --cmd "set rtp+=${repo_root}" \
    -c "lua require('bashly_bridge.project').print_source_projection(vim.fn.argv(0) ~= '' and vim.fn.argv(0) or '.')" \
    -c 'qa!' \
    -- "$workspace"
}

run_full_project() {
  workspace=${1:-.}
  exec nvim --headless -n -u NONE \
    --cmd "set rtp+=${repo_root}" \
    -c "lua require('bashly_bridge.project').print_bashly_cli(vim.fn.argv(0) ~= '' and vim.fn.argv(0) or '.')" \
    -c 'qa!' \
    -- "$workspace"
}

run_publish_diagnostics() {
  workspace=${1:-.}
  exec nvim --headless -n -u NONE \
    --cmd "set rtp+=${repo_root}" \
    -c "lua require('bashly_bridge.project').print_bashly_cli_and_publish(vim.fn.argv(0) ~= '' and vim.fn.argv(0) or '.')" \
    -c 'qa!' \
    -- "$workspace"
}

mode=${1:-}
case "$mode" in
--graph-only)
  shift
  run_graph_only "$@"
  ;;
--source-only)
  shift
  run_source_only "${1:-.}"
  ;;
--project)
  shift
  run_full_project "${1:-.}"
  ;;
--publish-diagnostics)
  shift
  run_publish_diagnostics "${1:-.}"
  ;;
'')
  run_full_project "."
  ;;
--*)
  printf 'usage: bin/bashly-project [workspace]\n' >&2
  exit 2
  ;;
*)
  run_full_project "$mode"
  ;;
esac
