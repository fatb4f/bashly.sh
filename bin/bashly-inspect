#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

PYTHONPATH="$repo_root/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 - "$@" <<'PY'
from __future__ import annotations

import sys

from bashly_bridge.discovery import DiscoveryError, discover_project_json


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    workspace = args[0] if args else "."

    try:
        print(discover_project_json(workspace))
    except DiscoveryError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    return 0


raise SystemExit(main())
PY
